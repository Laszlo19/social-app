<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: widget picker preview for StatsWidget - avatar, name and handle bars,
     and the two counts (drawables can't hold text, so they're bars too). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <size
        android:width="250dp"
        android:height="68dp" />
      <corners android:radius="16dp" />
      <solid android:color="@color/fork_widget_background" />
    </shape>
  </item>

  <!-- Avatar -->
  <item android:gravity="center_vertical|start" android:left="12dp" android:width="44dp" android:height="44dp">
    <shape android:shape="oval"><solid android:color="@color/fork_widget_bar" /></shape>
  </item>

  <!-- Name and handle -->
  <item android:gravity="top|start" android:left="68dp" android:top="22dp" android:width="80dp" android:height="10dp">
    <shape android:shape="rectangle"><corners android:radius="5dp" /><solid android:color="@color/fork_widget_text" /></shape>
  </item>
  <item android:gravity="top|start" android:left="68dp" android:top="38dp" android:width="60dp" android:height="8dp">
    <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/fork_widget_bar_light" /></shape>
  </item>

  <!-- Followers and following counts -->
  <item android:gravity="top|end" android:right="66dp" android:top="20dp" android:width="22dp" android:height="12dp">
    <shape android:shape="rectangle"><corners android:radius="6dp" /><solid android:color="@color/fork_widget_accent" /></shape>
  </item>
  <item android:gravity="top|end" android:right="60dp" android:top="38dp" android:width="34dp" android:height="7dp">
    <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/fork_widget_bar_light" /></shape>
  </item>
  <item android:gravity="top|end" android:right="18dp" android:top="20dp" android:width="22dp" android:height="12dp">
    <shape android:shape="rectangle"><corners android:radius="6dp" /><solid android:color="@color/fork_widget_accent" /></shape>
  </item>
  <item android:gravity="top|end" android:right="12dp" android:top="38dp" android:width="34dp" android:height="7dp">
    <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/fork_widget_bar_light" /></shape>
  </item>
</layer-list>
