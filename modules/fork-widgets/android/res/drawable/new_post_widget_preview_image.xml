<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: widget picker preview for NewPostWidget - the blue button, with a bar
     standing in for its label (drawables can't hold text). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <size
        android:width="160dp"
        android:height="48dp" />
      <corners android:radius="12dp" />
      <solid android:color="@color/fork_widget_accent" />
    </shape>
  </item>
  <item
    android:width="64dp"
    android:height="10dp"
    android:gravity="center">
    <shape android:shape="rectangle">
      <corners android:radius="5dp" />
      <solid android:color="#FFFFFF" />
    </shape>
  </item>
</layer-list>
